{
  "name": "eslint-config-wdzeng",
  "version": "0.16.0",
  "description": "wdzeng's ESLint rule presets",
  "author": "hyperbola",
  "license": "MIT",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "index.d.ts",
    "presets/**/*.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wdzeng/eslint-config"
  },
  "scripts": {
    "lint": "eslint --fix",
    "test": "vitest --reporter=verbose",
    "regen": "tests/autofix/regen.sh",
    "clean": "rm -rf tests/autofix/js/backup tests/autofix/ts/backup"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/eslint-plugin": "^1.6.19",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.1"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.13.1",
    "@typescript-eslint/utils": "^8.60.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": ">=1.1.26",
    "eslint": ">=10",
    "eslint-plugin-import-x": ">=4.9",
    "eslint-plugin-n": ">=17.11",
    "eslint-plugin-prettier": ">=5.1",
    "eslint-plugin-unicorn": ">=64",
    "prettier": ">=3",
    "typescript": ">=6",
    "typescript-eslint": ">=8.58"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  }
}
